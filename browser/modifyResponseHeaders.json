[
    {
        "id": 1,
        "action": {
            "type": "modifyHeaders",
            "responseHeaders": [
                {
                    "header": "content-security-policy",
                    "operation": "remove"
                },
                {
                    "header": "content-security-policy-report-only",
                    "operation": "remove"
                }
            ]
        },
        "condition": {
            "resourceTypes": ["main_frame", "sub_frame"],
            "urlFilter": "||discord.com^"
        }
    },
    {
        "id": 2,
        "action": {
            "type": "modifyHeaders",
            "responseHeaders": [
                {
                    "header": "content-type",
                    "operation": "set",
                    "value": "text/css"
                }
            ]
        },
        "condition": {
            "resourceTypes": ["stylesheet"],
            "urlFilter": "||raw.githubusercontent.com^"
        }
    },
    {
        "id": 3,
        "action": {
            "type": "modifyHeaders",
            "responseHeaders": [
                {
                    "header": "access-control-allow-origin",
                    "operation": "set",
                    "value": "*"
                },
                {
                    "header": "access-control-allow-methods",
                    "operation": "set",
                    "value": "GET, PUT, POST, PATCH, DELETE, OPTIONS"
                },
                {
                    "header": "access-control-allow-headers",
                    "operation": "set",
                    "value": "*"
                }
            ]
        },
        "condition": {
            "regexFilter": "^https://[^/]+/attachments/\\d+/CLOUD_[^/]+/\\d+/[^/?]+$",
            "initiatorDomains": ["discord.com"]
        }
    }
]
